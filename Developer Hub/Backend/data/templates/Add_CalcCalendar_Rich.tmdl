	hierarchy 'Calendar Hierarchy'
		lineageTag: 33333333-3333-3333-3333-33333333331e

		level 'YearMonth'
			lineageTag: 33333333-3333-3333-3333-33333333331f
			column: 'YearMonth'

		level 'WeekOfYear'
			lineageTag: 33333333-3333-3333-3333-333333333320
			column: 'WeekOfYear'

		level 'Date'
			lineageTag: 33333333-3333-3333-3333-333333333321
			column: 'Date'

	partition 'CalcCalendar' = calculated
		mode: import
		source = ```
				VAR _MonthStartFiscalYear = 10
				VAR _Min = MINX(ALL('CalcCalendar'[Date]), [Date])
				VAR _Today = TODAY()
				VAR _Start = DATE(YEAR(MIN(_Min, DATE(YEAR(_Today)-2,1,1))), 1, 1)
				VAR _End   = DATE(YEAR(_Today)+1, 12, 31)
				VAR _Dates = CALENDAR(_Start, _End)
				RETURN
				ADDCOLUMNS(
				    _Dates,
				    "Year",            YEAR([Date]),
				    "Quarter",         "Q" & FORMAT([Date], "Q"),
				    "Month",           FORMAT([Date], "MMMM"),
				    "MonthNumber",     MONTH([Date]),
				    "YearMonth",       FORMAT([Date], "YYYY-MM"),
				    "YearMonthKey",    YEAR([Date])*100 + MONTH([Date]),
				    "DayOfMonth",      DAY([Date]),
				    "DayOfWeek",       FORMAT([Date], "dddd"),
				    "DayOfWeekNumber", WEEKDAY([Date], 2),
				    "WeekOfYear",      WEEKNUM([Date], 2),
				    "FiscalYear",      IF(MONTH([Date]) >= _MonthStartFiscalYear, YEAR([Date])+1, YEAR([Date])),
				    "FiscalQuarter",   "FQ" & FORMAT(EDATE([Date], 13 - _MonthStartFiscalYear), "Q"),
				    "FiscalMonth",     MOD(MONTH([Date]) - _MonthStartFiscalYear + 12, 12) + 1,
				    "IsWeekend",       WEEKDAY([Date], 2) > 5,
				    "IsCurrentMonth",  YEAR([Date]) = YEAR(TODAY()) && MONTH([Date]) = MONTH(TODAY()),
				    "IsCurrentYear",   YEAR([Date]) = YEAR(TODAY()),
				    "DateInt",         YEAR([Date])*10000 + MONTH([Date])*100 + DAY([Date])
				)
				```

	annotation PBI_Id = CalcCalendar
