{
    "//": "Identity/secret values (PublisherTenantId, ClientId, ClientSecret, Audience, GitHubClientId) come from .env at the repo root. Do not commit them here. See Developer Hub/.env.example.",
    "Application": {
        "Name": "Microsoft Fabric Python Backend",
        "Environment": "Development",
        "Debug": false
    },
    "Server": {
        "Host": "0.0.0.0",
        "Port": 5000,
        "Workers": 1,
        "ShutdownTimeout": 3,
        "ForceShutdownTimeout": 5
    },
    "Security": {
        "//": "Fabric-embedded workloads are loaded inside the Fabric portal iframe. CORS origins must be the concrete portal hosts your workload is registered in. Add local dev origins via appsettings.Development.json, not here.",
        "AllowedHosts": [
            "app.fabric.microsoft.com",
            "msit.fabric.microsoft.com",
            "dxt.fabric.microsoft.com",
            "df.fabric.microsoft.com",
            "app.powerbi.com",
            "msit.powerbi.com"
        ],
        "CorsOrigins": [
            "https://app.fabric.microsoft.com",
            "https://msit.fabric.microsoft.com",
            "https://dxt.fabric.microsoft.com",
            "https://df.fabric.microsoft.com",
            "https://app.powerbi.com",
            "https://msit.powerbi.com"
        ]
    },
    "Logging": {
        "LogLevel": "Information"
    },
    "Storage": {
        "Metadata": {
            "JobsDirectory": "jobs",
            "CommonMetadataFile": "common_metadata.json",
            "TypeSpecificMetadataFile": "type_specific_metadata.json"
        }
    }
}