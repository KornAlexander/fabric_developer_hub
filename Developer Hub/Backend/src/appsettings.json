{
    "//": "Identity/secret values (PublisherTenantId, ClientId, ClientSecret, Audience, GitHubClientId) come from .env at the repo root. Do not commit them here. See Developer Hub/.env.example.",
    "Application": {
        "Name": "Microsoft Fabric Python Backend",
        "Environment": "Development",
        "Debug": true
    },
    "Server": {
        "Host": "0.0.0.0",
        "Port": 5000,
        "Workers": 1,
        "ShutdownTimeout": 3,
        "ForceShutdownTimeout": 5
    },
    "Security": {
        "AllowedHosts": ["*"],
        "CorsOrigins": ["*"]
    },
    "Logging": {
        "LogLevel": "Information"
    },
    "Storage": {
        "Metadata": {
            "JobsDirectory": "jobs",
            "CommonMetadataFile": "common_metadata.json",
            "TypeSpecificMetadataFile": "type_specific_metadata.json"
        }
    }
}