<?xml version="1.0" encoding="utf-8" ?>
<!--
  Template file. Placeholders of the form ${VAR} are substituted from the
  environment (AgentHub/.env) by tools/manifest_package_generator.py at
  package-build time. Do NOT hard-code AppId / tenant / workload name here.
-->
<WorkloadManifestConfiguration xmlns:xsi= "http://www.w3.org/2001/XMLSchema-instance" SchemaVersion="1.101.0">
  <Workload WorkloadName="${WORKLOAD_NAME}" HostingType="Remote">
    <Version>1.0.0</Version>
    <RemoteServiceConfiguration>
      <CloudServiceConfiguration>
        <Cloud>Public</Cloud>
        <AADApp>
          <AppId>${CLIENT_ID}</AppId>
          <RedirectUri>http://localhost:60006/close</RedirectUri>
          <ResourceId>${AUDIENCE}</ResourceId>
        </AADApp>
        <Endpoints>
          <!--
            Declaring these URLs here adds them to Fabric's per-workload
            allowlist at load time. Any URL whose origin matches one of
            these endpoints is accepted by
            ``workloadClient.navigation.openBrowserTab`` — crucial for
            features that hand an http(s) URL back to the host portal
            (attachment download, preview "open in tab", etc.).

            Fabric requires HTTPS for any non-Microsoft origin. The
            defaults below match our legacy placeholders; production
            builds set ``WORKLOAD_BACKEND_URL`` / ``WORKLOAD_FRONTEND_URL``
            in ``Developer Hub/.env`` (see ``.env.example``).
          -->
          <ServiceEndpoint>
            <Name>Workload</Name>
            <Url>${WORKLOAD_BACKEND_URL}</Url>
            <IsEndpointResolutionService>false</IsEndpointResolutionService>
          </ServiceEndpoint>
          <ServiceEndpoint>
            <Name>Frontend</Name>
            <Url>${WORKLOAD_FRONTEND_URL}</Url>
            <IsEndpointResolutionService>false</IsEndpointResolutionService>
          </ServiceEndpoint>
        </Endpoints>
      </CloudServiceConfiguration>
    </RemoteServiceConfiguration>
  </Workload>
</WorkloadManifestConfiguration>