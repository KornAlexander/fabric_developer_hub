# ============================================================
# Single source of truth for all environment-specific config.
# Shared by Frontend (via env-cmd) and Backend (via dotenv).
# Copy this to .env and fill in your values.
# ============================================================

# Workload identity — substituted into Backend/.../WorkloadManifest.xml
# and Item1.xml at package-build time by manifest_package_generator.py.
WORKLOAD_NAME=Org.YourWorkload

# Azure AD / Entra ID
# CLIENT_ID  → <AppId>       in WorkloadManifest.xml
# AUDIENCE   → <ResourceId>  in WorkloadManifest.xml
#              (= Application ID URI on your AAD app; tenant GUID must
#               match PUBLISHER_TENANT_ID)
PUBLISHER_TENANT_ID=your-tenant-id
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret
AUDIENCE=api://localdevinstance/your-tenant-id/Org.YourWorkload/suffix

# Backend server
# Use 127.0.0.1 rather than localhost to avoid Chrome's ~300ms
# IPv6-then-IPv4 fallback penalty on each new TCP connection.
#
# NOTE: For `workloadClient.navigation.openBrowserTab` (used by the
# attachment download button and "Open in tab" links) to accept a URL,
# Fabric requires (a) the origin to be on its per-workload allowlist
# declared in WorkloadManifest.xml via WORKLOAD_BACKEND_URL /
# WORKLOAD_FRONTEND_URL below, and (b) the URL scheme to be `https://`
# for any non-Microsoft origin. Plain `http://127.0.0.1:5000` is
# rejected by the Fabric host even when it is the registered workload
# endpoint, so downloads that mint a backend URL fall back to the
# in-frame blob path. Point WORKLOAD_BE_URL at an HTTPS tunnel (e.g.
# the dev-gateway HTTPS proxy) to exercise the openBrowserTab path
# locally.
WORKLOAD_BE_URL=http://127.0.0.1:5000
HOST=0.0.0.0
PORT=5000
WORKERS=1

# ── Fabric workload allowlist ──────────────────────────────
# Registered in WorkloadManifest.xml at package-build time. Fabric uses
# these to allowlist which origins `openBrowserTab` may navigate to for
# this workload. Must be HTTPS (non-Microsoft origins). The defaults
# (see manifest_package_generator.OPTIONAL_ENV_DEFAULTS) keep the legacy
# placeholder URLs so unchanged configs still build; set these in prod
# to your real workload origin(s).
# WORKLOAD_BACKEND_URL=https://your-backend.example.com/workload
# WORKLOAD_FRONTEND_URL=https://your-frontend.example.com

# Fabric workspace (needed by DevGateway)
WORKSPACE_GUID=your-workspace-guid

# Runtime
PYTHON_ENVIRONMENT=Development
DEBUG=false
LOG_LEVEL=Information
