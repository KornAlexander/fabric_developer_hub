# ============================================================
# Single source of truth for all environment-specific config.
# Shared by Frontend (via env-cmd) and Backend (via dotenv).
# Copy this to ../.env and fill in your values.
# ============================================================

# Workload identity — substituted into Backend/.../WorkloadManifest.xml
# and Item1.xml at package-build time by manifest_package_generator.py.
WORKLOAD_NAME=Org.YourWorkload

# Azure AD / Entra ID
# CLIENT_ID  → <AppId>       in WorkloadManifest.xml
# AUDIENCE   → <ResourceId>  in WorkloadManifest.xml
#              (= Application ID URI on your AAD app; tenant GUID must
#               match PUBLISHER_TENANT_ID)
PUBLISHER_TENANT_ID=your-tenant-id
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret
AUDIENCE=api://localdevinstance/your-tenant-id/Org.YourWorkload/suffix

# GitHub (for chat integration)
GITHUB_CLIENT_ID=your-github-client-id

# Backend server
WORKLOAD_BE_URL=http://localhost:5000
HOST=0.0.0.0
PORT=5000
WORKERS=1

# Fabric workspace (needed by DevGateway)
WORKSPACE_GUID=your-workspace-guid

# Runtime
PYTHON_ENVIRONMENT=Development
DEBUG=false
LOG_LEVEL=Information

# Note: AGENTHUB_DB_PATH is NOT configured here. For Docker runs it is set in
# docker-compose.yaml (single source of truth) and persisted to the host via
# the ./Backend/.data bind mount. For native runs the default location
# ~/.config/<workload>/agenthub.db is used automatically.
