{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "lib": [
            "ES2022",
            "DOM"
        ],
        "module": "commonjs",
        "noImplicitAny": false,
        "noUnusedLocals": false,
        "target": "ES2022",
        "types": [
            "node",
            "@playwright/test"
        ]
    },
    "include": [
        "./**/*.ts"
    ],
    "exclude": [
        "../node_modules"
    ]
}
