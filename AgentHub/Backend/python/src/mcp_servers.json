{
  "servers": {
    "fabric": {
      "command": "${PYTHON}",
      "args": ["${SRC_DIR}/services/fabric_mcp_server.py"],
      "requires_auth": true
    },
    "semantic-link": {
      "command": "${PYTHON}",
      "args": ["${SRC_DIR}/services/semantic_link_mcp_server.py"],
      "requires_auth": true
    },
    "pbi-fixer": {
      "command": "${PYTHON}",
      "args": ["${REPO_DIR}/mcp/pbi_fixer/server.py"],
